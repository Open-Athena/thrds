{
  "name": "@open-athena/thrds",
  "version": "0.2.0-dist.0d6869f",
  "description": "Slack toolkit + declarative thread sync: transport, rich messages, slotted threads over pluggable stores (D1/KV), a request receiver, and badged sender avatars",
  "license": "MIT",
  "author": "Ryan Williams",
  "homepage": "https://github.com/Open-Athena/thrds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Athena/thrds.git"
  },
  "bugs": {
    "url": "https://github.com/Open-Athena/thrds/issues"
  },
  "keywords": [
    "slack",
    "thread",
    "sync",
    "declarative",
    "diff",
    "bot",
    "cloudflare-workers",
    "d1",
    "block-kit",
    "avatar"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./avatar": {
      "types": "./avatar.d.ts",
      "import": "./avatar.js",
      "default": "./avatar.js"
    },
    "./d1": {
      "types": "./d1.d.ts",
      "import": "./d1.js",
      "default": "./d1.js"
    },
    "./kv": {
      "types": "./kv.d.ts",
      "import": "./kv.js",
      "default": "./kv.js"
    },
    "./receiver": {
      "types": "./receiver.d.ts",
      "import": "./receiver.js",
      "default": "./receiver.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "import": "./testing.js",
      "default": "./testing.js"
    },
    "./schema/thrds.sql": "./thrds.sql"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
