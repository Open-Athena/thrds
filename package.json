{
  "name": "@open-athena/thrds",
  "version": "0.2.0",
  "description": "Slack toolkit + declarative thread sync: transport, rich messages, slotted threads over pluggable stores (D1/KV), a request receiver, and badged sender avatars",
  "license": "MIT",
  "author": "Ryan Williams",
  "homepage": "https://github.com/Open-Athena/thrds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Athena/thrds.git"
  },
  "bugs": {
    "url": "https://github.com/Open-Athena/thrds/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "slack",
    "thread",
    "sync",
    "declarative",
    "diff",
    "bot",
    "cloudflare-workers",
    "d1",
    "block-kit",
    "avatar"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js",
      "default": "./dist/avatar.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js",
      "default": "./dist/d1.js"
    },
    "./kv": {
      "types": "./dist/kv.d.ts",
      "import": "./dist/kv.js",
      "default": "./dist/kv.js"
    },
    "./receiver": {
      "types": "./dist/receiver.d.ts",
      "import": "./dist/receiver.js",
      "default": "./dist/receiver.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./schema/thrds.sql": "./schema/thrds.sql"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.0.0"
}
